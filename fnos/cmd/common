#!/bin/bash
# Helpers for fnOS native lifecycle hooks.
install_log() {
    printf '%s\n' "$*" >&2
}
lifecycle_error() {
    local code="$1"
    trap - ERR
    local message="MoviePilot V3 ${LIFECYCLE_HOOK:-lifecycle} failed (exit ${code}); see the application install log."
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$message" >> "$TRIM_TEMP_LOGFILE"
    fi
    install_log "$message"
    exit "$code"
}
validate_lifecycle_context() {
    [ "${TRIM_APPNAME:-}" = moviepilot-v3 ] || { install_log 'Unexpected application identity'; return 1; }
    [ -n "${TRIM_PKGVAR:-}" ] && [ -n "${TRIM_APPDEST:-}" ] || {
        install_log 'Missing fnOS application paths'; return 1;
    }
    local resolved
    resolved="$(realpath -m -- "$TRIM_PKGVAR")"
    case "$resolved" in
        /*/@appdata/moviepilot-v3) ;;
        *) install_log "Unexpected V3 private data path: $TRIM_PKGVAR"; return 1 ;;
    esac
}
stop_native_service() {
    # Stop the Python supervisor, Node gateway and log mirror together.
    bash "${LIFECYCLE_CMD_DIR}/main" stop
}
