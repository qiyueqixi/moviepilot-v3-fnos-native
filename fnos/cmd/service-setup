#!/bin/bash
set -e

VENV="${TRIM_PKGVAR}/venv"
. "$(dirname "${BASH_SOURCE[0]}")/runtime"
. "$(dirname "${BASH_SOURCE[0]}")/environment"

prepare_system_log() {
    local system_log="/var/log/apps/${TRIM_APPNAME:-moviepilot-v3}.log"
    touch "$system_log" 2>/dev/null || return 0
    if [ -n "${TRIM_UID:-}" ] && [ -n "${TRIM_GID:-}" ]; then
        chown "${TRIM_UID}:${TRIM_GID}" "$system_log" 2>/dev/null || true
    fi
    chmod 640 "$system_log" 2>/dev/null || true
}

get_config_dir() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}"
    local config_dir="${paths%%:*}"
    [ -n "$config_dir" ] || config_dir="${TRIM_PKGVAR}/config"
    printf '%s' "$config_dir"
}

validate_proxy() {
    local proxy="$1"
    [ -n "$proxy" ] || return 0
    case "$proxy" in
        http://*|https://*) ;;
        *) install_log "代理地址必须以 http:// 或 https:// 开头"; return 1 ;;
    esac
}

save_app_proxy() {
    local proxy="$1"
    local config_dir="$(get_config_dir)"
    local app_env="${config_dir}/app.env"
    local temp_env="${app_env}.tmp.$$"
    validate_proxy "$proxy"
    mkdir -p "$config_dir"
    if [ -f "$app_env" ]; then
        awk -v value="$proxy" '
            BEGIN { updated = 0; quote = sprintf("%c", 39) }
            /^[[:space:]]*PROXY_HOST[[:space:]]*=/ {
                if (!updated) print "PROXY_HOST=" quote value quote
                updated = 1
                next
            }
            { print }
            END { if (!updated) print "PROXY_HOST=" quote value quote }
        ' "$app_env" > "$temp_env"
        chown --reference="$app_env" "$temp_env" 2>/dev/null || true
    else
        printf "PROXY_HOST='%s'\n" "$proxy" > "$temp_env"
        if [ -n "${TRIM_UID:-}" ] && [ -n "${TRIM_GID:-}" ]; then
            chown "${TRIM_UID}:${TRIM_GID}" "$temp_env" 2>/dev/null || true
        fi
    fi
    chmod 600 "$temp_env"
    mv -f "$temp_env" "$app_env"
}

service_postinst() {
    mkdir -p "${TRIM_PKGVAR}/core"
    prepare_native_environment
    local path
    local -a shares
    IFS=: read -r -a shares <<< "${TRIM_DATA_SHARE_PATHS:-}"
    for path in "${shares[@]}"; do
        [ -z "$path" ] || mkdir -p -- "$path"
    done
    [ -z "${wizard_proxy:-}" ] || save_app_proxy "$wizard_proxy"
    local bundled_runtime="${TRIM_APPDEST}/runtime/venv.tgz"
    if [ -f "$bundled_runtime" ]; then
        runtime_install_archive "$bundled_runtime" || { install_log "离线运行时校验或解压失败"; return 1; }
    fi
    prepare_system_log
    chown -R "${TRIM_UID}:${TRIM_GID}" "${TRIM_PKGVAR}" 2>/dev/null || true
    chown -R "${TRIM_UID}:${TRIM_GID}" "${TRIM_APPDEST}" 2>/dev/null || true
    for path in "${shares[@]}"; do
        [ -z "$path" ] || chown "${TRIM_UID}:${TRIM_GID}" "$path" 2>/dev/null || true
    done
}

service_postconfig() {
    if [ -n "${wizard_proxy:-}" ]; then
        save_app_proxy "$wizard_proxy"
    elif [ "${wizard_clear_app_proxy:-false}" = "true" ]; then
        save_app_proxy ""
    fi
}

cleanup_targets() {
    [ "${TRIM_APPNAME:-}" = moviepilot-v3 ] || return 1
    local path resolved kind
    local -a shares
    IFS=: read -r -a shares <<< "${TRIM_DATA_SHARE_PATHS:-}"
    for path in "${shares[@]}"; do
        [ -n "$path" ] || continue
        # Resolve aliases before checking identity; a share symlink must not
        # redirect deletion into V2, a media library or a download directory.
        resolved="$(realpath -m -- "$path")" || return 1
        case "$resolved" in
            /*/moviepilot-v3/config|/*/moviepilot-v3/logs|/*/moviepilot-v3/exports|/*/moviepilot-v3/runtime)
                printf '%s\n' "$resolved" ;;
            *) install_log "Refusing unexpected shared data path: $path"; return 1 ;;
        esac
    done
    for kind in PKGVAR PKGETC PKGHOME; do
        case "$kind" in
            PKGVAR) path="${TRIM_PKGVAR:-}"; kind=@appdata ;;
            PKGETC) path="${TRIM_PKGETC:-}"; kind=@appconf ;;
            PKGHOME) path="${TRIM_PKGHOME:-}"; kind=@apphome ;;
        esac
        [ -n "$path" ] || continue
        resolved="$(realpath -m -- "$path")" || return 1
        case "$resolved" in
            /*/"$kind"/moviepilot-v3) printf '%s\n' "$resolved" ;;
            *) install_log "Refusing unexpected private data path: $path"; return 1 ;;
        esac
    done
}

validate_cleanup_paths() {
    cleanup_targets > /dev/null
}

service_postuninst() {
    [ "${wizard_delete_data:-false}" = "true" ] || return 0
    local targets path parent
    # Capture successfully validated targets before the first destructive step.
    targets="$(cleanup_targets)" || return 1
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        rm -rf -- "$path"
        parent="${path%/*}"
        case "$parent" in
            */moviepilot-v3) rmdir -- "$parent" 2>/dev/null || true ;;
        esac
    done <<< "$targets"
}

service_postupgrade() {
    mkdir -p "${TRIM_PKGVAR}/core"
    service_postinst
}
