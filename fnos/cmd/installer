#!/bin/bash
set -Eeuo pipefail
LIFECYCLE_CMD_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
. "${LIFECYCLE_CMD_DIR}/common"
trap 'lifecycle_error "$?"' ERR
. "${LIFECYCLE_CMD_DIR}/service-setup"

lifecycle_main() {
    LIFECYCLE_HOOK="$1"
    validate_lifecycle_context
    install_log "MoviePilot V3: ${LIFECYCLE_HOOK}"
    case "$LIFECYCLE_HOOK" in
        install_init|config_init)
            validate_proxy "${wizard_proxy:-}"
            ;;
        install_callback)
            service_postinst
            ;;
        upgrade_init)
            validate_proxy "${wizard_proxy:-}"
            stop_native_service
            ;;
        upgrade_callback)
            service_postupgrade
            ;;
        config_callback)
            service_postconfig
            ;;
        uninstall_init)
            # Check all targets before stopping or removing anything.
            [ "${wizard_delete_data:-false}" != true ] || validate_cleanup_paths
            stop_native_service
            service_postuninst
            ;;
        uninstall_callback)
            # Cleanup may run again after fnOS has removed package files.
            service_postuninst
            ;;
        *) install_log 'Unknown lifecycle hook'; return 1 ;;
    esac
}
